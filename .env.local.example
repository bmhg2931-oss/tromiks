# העתק/י קובץ זה ל-.env.local ומלא/י את הערכים מתוך Supabase:
# Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# מפתח service_role (או "Secret key" בממשק ה-API Keys החדש של Supabase) - גישה
# מלאה שעוקפת RLS. נדרש למחיקת משתמשים ולמייל תזכורות מה-cron. סודי לחלוטין -
# לעולם לא עם קידומת NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# כתובת הבסיס של האתר - לבניית קישורים במיילים (למשל "מעבר לכרטיס איש הקשר"
# בתזכורות). מקומית: http://localhost:3000. בענן: הכתובת הציבורית האמיתית
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# סליקת אשראי נדרים פלוס (matara.pro) - יש לבקש מהמשרד שלהם
# ה-ApiValid אינו סוד שרת: הוא נשלח מהדפדפן ישירות לאייפרם שלהם (בדיוק כמו בדוגמה הרשמית שלהם)
NEXT_PUBLIC_NEDARIM_MOSAD=YOUR-7-DIGIT-MOSAD-ID
NEXT_PUBLIC_NEDARIM_API_VALID=YOUR-API-VALID-TOKEN

# אופציונלי: כתובת מייל לקבלת התראה אם עדכון ה-CallBack של נדרים פלוס נכשל להישלח.
# נדרש במוסד הבדיקות (Mosad=0); במוסד אמיתי, אם נשאר ריק, ההתראה תישלח למנהלי המוסד
NEXT_PUBLIC_NEDARIM_CALLBACK_ERROR_EMAIL=your-email@example.com

# מפתח API של Anthropic (Claude) - להפעלת צ'אט ה-AI. מ-console.anthropic.com
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# שליחת מיילים אמיתית מתוך קמפיינים, דרך Resend (resend.com)
RESEND_API_KEY=YOUR-RESEND-API-KEY
RESEND_FROM_EMAIL=onboarding@resend.dev


# שיחות VoIP אמיתיות מהדפדפן דרך Twilio Voice (console.twilio.com)
# TWILIO_TWIML_APP_SID: יש ליצור TwiML App עם Voice Request URL שמצביע ל-
#   https://<הכתובת-הציבורית-שלך>/api/twilio-voice (לא יעבוד מול localhost בלבד - נדרש ngrok/פריסה)
TWILIO_ACCOUNT_SID=YOUR-TWILIO-ACCOUNT-SID
TWILIO_API_KEY_SID=YOUR-TWILIO-API-KEY-SID
TWILIO_API_KEY_SECRET=YOUR-TWILIO-API-KEY-SECRET
TWILIO_TWIML_APP_SID=YOUR-TWILIO-TWIML-APP-SID
TWILIO_CALLER_ID=+972XXXXXXXXX

# השלמת מיקוד אוטומטית לפי כתובת (בטופס איש קשר), דרך Google Maps Geocoding API -
# יש ליצור פרויקט ב-console.cloud.google.com, להפעיל בו "Geocoding API", וליצור
# מפתח API עם חיוב פעיל (יש שכבה חינמית חודשית)
GOOGLE_MAPS_API_KEY=YOUR-GOOGLE-MAPS-API-KEY
